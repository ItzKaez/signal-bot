# ── Telegram ──
# Token via @BotFather (/newbot). Sans TELEGRAM_CHAT_ID au premier
# démarrage : écrivez /start à votre bot, il vous répond votre chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Marchés ──
PAIRS=BTC,ETH,SOL,BNB,XRP
QUOTE=USDT
CAPITAL=10000

# ── Sources POC (les 7 des backtests) ──
POC_SOURCES=BINANCE:USD,BINANCE:USDT.P,BYBIT:USDT.P,OKX:USDT.P,BITFINEX:USD,COINBASE:USD,COINBASE:USDT

# ── Boucle ──
POLL_SEC=20
WARMUP_DAYS=90
CATCHUP_DAYS=3

# ── Divers ──
# DRY_RUN=1                      # console uniquement, pas de Telegram
# SIGNAL_OVERRIDE={"wickStopMode":"immediate"}   # surcharge stratégie (JSON)
# SIGNAL_OVERRIDE={"executionSeconds":[60,300,900,1800]}  # version cascade complète
